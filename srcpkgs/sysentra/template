# Template file for 'sysentra'
pkgname=sysentra
version=0.3.0
revision=1
hostmakedepends="go wails3 nodejs pkg-config"
makedepends="gtk4-devel libwebkitgtk60-devel"
depends="dbus polkit"
short_desc="System management center for Void Linux"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/nerdyslacker/Sysentra"
distfiles="https://github.com/nerdyslacker/Sysentra/archive/refs/tags/v${version}.tar.gz"
checksum=970b21ae9cff5547798068a3a8d42694b7b6bdbf931fbbec4f7384e7bb14fe34
nopie=yes

do_build() {
	wails3 generate bindings -ts .
	npm ci --prefix frontend
	npm run --prefix frontend build
	go build -buildvcs=false -o sysentra .
	go build -buildvcs=false -o sysentrad ./cmd/sysentrad
}

do_install() {
	vbin sysentra
	vinstall sysentrad 755 usr/libexec
	vinstall packaging/dbus/io.github.nerdyslacker.Sysentra.System1.conf 644 usr/share/dbus-1/system.d
	vinstall packaging/dbus/io.github.nerdyslacker.Sysentra.System1.service 644 usr/share/dbus-1/system-services
	vinstall packaging/polkit/io.github.nerdyslacker.sysentra.policy 644 usr/share/polkit-1/actions
	vinstall packaging/linux/io.github.nerdyslacker.Sysentra.desktop 644 usr/share/applications
	vinstall assets/sysentra.png 644 usr/share/icons/hicolor/scalable/apps sysentra.png
	vlicense LICENSE
}
