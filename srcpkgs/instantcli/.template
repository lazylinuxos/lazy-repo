# Template file for 'instantcli'
pkgname=instantcli
version=${VERSION}
revision=1
build_style=cargo
build_helper="rust"
make_build_args="--all-features"
make_check_args="--all-features"
hostmakedepends="pkgconf"
makedepends="sqlite-devel openssl-devel"
depends="fzf git"
checkdepends="ntfs-3g ffmpeg"
short_desc="CLI tool for managing dotfiles, system diagnostics, and configs"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-2.0-only"
homepage="https://instantos.io"
distfiles="https://github.com/instantOS/instantCLI/archive/refs/tags/v${version}.tar.gz"
checksum=${SHA256}

do_install() {
	vbin target/${RUST_TARGET}/release/ins

	vinstall src/assist/actions/emoji/LICENSE 644 \
		usr/share/licenses/ins emoji-catalog-LICENSE

	vdoc README.md

	for desktop_file in desktop/*.desktop; do
		[ -f "$desktop_file" ] || continue
		vinstall "$desktop_file" 644 usr/share/applications
	done

	vsv ins-notify
}
