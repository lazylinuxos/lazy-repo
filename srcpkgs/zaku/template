# Template file for 'zaku'
pkgname=zaku
version=26.0
revision=1
build_style=cargo
build_helper="rust"
hostmakedepends="clang cmake llvm pkg-config git"
makedepends="alsa-lib-devel fontconfig-devel libX11-devel libxcb-devel
 libxkbcommon-devel openssl-devel vulkan-loader sqlite-devel libzstd-devel"
short_desc="Fast, native, local-first API client"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="AGPL-3.0-or-later"
homepage="https://zaku.dev"
distfiles="https://github.com/buildzaku/zaku/archive/refs/tags/${version}.tar.gz"
checksum=e65d7ccb7d71fc2a17065e4dfcbf15594bf47f9e00f391bcf49cdc2ed3b15e79

pre_configure() {
	sed -i '/fn commit_sha()/,/^}/c\
fn commit_sha() -> String {\
	"RELEASE".to_string()\
}' crates/metadata/build.rs
}

do_install() {
	vbin target/${RUST_TARGET}/release/zaku
	vinstall crates/zaku/resources/dev.zaku.Zaku.desktop \
		644 usr/share/applications
	vinstall crates/zaku/resources/app-icon.png \
		644 usr/share/icons/hicolor/512x512/apps zaku.png
	vinstall crates/zaku/resources/app-icon@2x.png \
		644 usr/share/icons/hicolor/1024x1024/apps zaku.png
	vlicense LICENSE
}
