# Template file for 'tauon-bin'
pkgname=tauon-bin
version=13.1.0
revision=1
depends="python3-pychromecast"
short_desc="Modern music player"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://tauonmusicbox.rocks"
distfiles="https://github.com/Taiko2k/Tauon/releases/download/v${version}/TauonMusicBox-linux.7z"
checksum=7780f2d1234cfddec1defdd0c0d3a485040b16fb41e3b4c955e5f4211d84b290
nopie=yes
noverifyrdeps=yes
noshlibprovides=yes
python_version=3

do_install() {
	vmkdir usr/lib/tauon
	vcopy * usr/lib/tauon/

    # Disable portable mode for system-wide installation
    rm -f "${DESTDIR}/usr/lib/tauon/_internal/portable"

	vinstall ${FILESDIR}/tauonmb.svg 644 usr/share/pixmaps
	vinstall ${FILESDIR}/tauon.desktop 644 usr/share/applications

	vbin ${FILESDIR}/tauon.sh tauon
}
