# Template file for 'lazy-zsh-config'
pkgname=lazy-zsh-config
version=0.0.2
revision=1
archs="x86_64"
hostmakedepends="tar"
depends="zsh oh-my-zsh zsh-syntax-highlighting zsh-autosuggestions zsh-history-substring-search zsh-theme-powerlevel10k"
short_desc="LazyLinux Zsh config"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="Apache-2.0"
homepage="https://github.com/lazylinuxos/lazy-zsh-config"
distfiles="https://github.com/lazylinuxos/lazy-zsh-config/archive/refs/tags/v${version}.tar.gz"
checksum=d92c6665eced873fa2af390286ef05366edd85ede5dcde9c184bcb682a36dab3
conf_files="/etc/skel/.zshrc"

do_install() {
	vmkdir /usr/share/lazy-zsh-config
	vcopy usr/share/lazy-zsh-config/* /usr/share/lazy-zsh-config
	vinstall zshrc 644 etc/skel .zshrc
}
