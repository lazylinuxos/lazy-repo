# Template file for 'ghee'
pkgname=ghee
version=${VERSION}
revision=1
hostmakedepends="zig16"
depends="git openssh"
short_desc="Git TUI over every repository in a folder"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://justaguy.dev/drew/ghee"
distfiles="https://justaguy.dev/drew/ghee/archive/v${version}.tar.gz"
checksum=${SHA256}

do_build() {
    zig build -Doptimize=ReleaseSafe -Dcpu=baseline \
        -Dversion="${version}"
}

do_install() {
    vbin zig-out/bin/ghee
    vman data/ghee.1
    vdoc README.md
}
