# Template file for 'qt6pas'
pkgname=qt6pas
version=6.2.10
revision=1
build_style=qmake
configure_args="cbindings/Qt6Pas.pro"
hostmakedepends="qt6-tools"
makedepends="qt6-base-devel"
short_desc="Qt6 interface bindings for Pascal"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="LGPL-3.0-or-later"
homepage="https://wiki.lazarus.freepascal.org/Qt6_Interface"
distfiles="https://github.com/davidbannon/libqt6pas/archive/refs/tags/v${version}.tar.gz"
checksum=dbcc13559f991958fb69de31d67c85575bbe278fdff0813b51787da50720d591

post_install() {
	vinstall cbindings/qt6.pas 0644 usr/share/pascal/qt6
}

qt6pas-devel_package() {
	depends="qt6pas-${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove "usr/lib/*.so"
		vmove "usr/share/pascal/qt6/*.pas"
	}
}
