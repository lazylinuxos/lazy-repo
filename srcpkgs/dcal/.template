# Template file for 'dcal'
pkgname=dcal
version=${VERSION}
revision=1
build_style=go
build_wrksrc="core"
go_import_path="github.com/duxlabs-dev/dux-calendar/core"
go_package="${go_import_path}/cmd/dcal"
go_build_tags="withshell"
go_ldflags="-linkmode=external -X main.Version=${version}"
hostmakedepends="pkg-config tar"
makedepends="qt6-base-devel qt6-declarative-devel qt6-svg-devel qt6-wayland-devel qt6-tools-devel"
depends="font-inter ttf-material-icons"
short_desc="Standalone calendar app that brings all your calendars together"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="MIT"
homepage="https://github.com/duxlabs-dev/dux-calendar"
distfiles="https://github.com/duxlabs-dev/dux-calendar/releases/download/v${version}/dankcalendar-${version}.tar.gz"
checksum=${SHA256}

pre_build() {
	make sync-shell
}

post_install() {
	vinstall "${wrksrc}/assets/dev.duxlabs.calendar.desktop" 644 usr/share/applications
	vinstall "${wrksrc}/assets/dev.duxlabs.calendar.metainfo.xml" 644 usr/share/metainfo
	vinstall "${wrksrc}/assets/dev.duxlabs.calendar.svg" 644 usr/share/icons/hicolor/scalable/apps

	vmkdir usr/share/quickshell/dankcal
	vcopy "${wrksrc}/quickshell/*" usr/share/quickshell/dankcal

	if [ -z "$CROSS_BUILD" ]; then
		vmkdir usr/share/bash-completion/completions
		vmkdir usr/share/zsh/site-functions
		vmkdir usr/share/fish/vendor_completions.d
		"${DESTDIR}/usr/bin/dcal" completion bash > "${DESTDIR}/usr/share/bash-completion/completions/dcal"
		"${DESTDIR}/usr/bin/dcal" completion zsh  > "${DESTDIR}/usr/share/zsh/site-functions/_dcal"
		"${DESTDIR}/usr/bin/dcal" completion fish > "${DESTDIR}/usr/share/fish/vendor_completions.d/dcal.fish"
	fi

	vlicense "${wrksrc}/LICENSE"
	vsv dcal
}
