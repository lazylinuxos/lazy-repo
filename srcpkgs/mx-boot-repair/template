# Template file for 'mx-boot-repair'
pkgname=mx-boot-repair
version=26.07
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release
 -DHELPER_INSTALL_DIR=/usr/lib/mx-boot-repair
 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
 -DPROJECT_VERSION_OVERRIDE=${version}"
hostmakedepends="qt6-tools"
makedepends="qt6-base-devel"
depends="efibootmgr polkit"
short_desc="GUI tool for repairing GRUB bootloader"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://mxlinux.org"
distfiles="https://github.com/MX-Linux/mx-bootrepair/archive/refs/tags/${version}.tar.gz"
checksum=a7653fb7f0818faf8bb8fef029788b85f0f8b137e86379b657459add0a5f3e94

post_install() {
	for qm in build/*.qm; do
		[ -f "$qm" ] || continue
		vinstall "$qm" 644 usr/share/mx-bootrepair/locale
	done

	vinstall build/org.mxlinux.pkexec.mxbr-helper.policy 644 usr/share/polkit-1/actions
	vinstall mx-boot-repair.desktop 644 usr/share/applications
	vinstall icons/mx-boot-repair.png 644 usr/share/icons/hicolor/64x64/apps
	vinstall icons/mx-boot-repair.svg 644 usr/share/icons/hicolor/scalable/apps
	vman man/mx-boot-repair.1

	if [ -d help ]; then
		for file in help/*; do
			[ -f "$file" ] || continue
			vinstall "$file" 644 usr/share/doc/mx-bootrepair
		done
	fi
}
