pre_build() {
	CFLAGS+=" -I/usr/include/freetype2 -DVERSION=\\\"${version}\\\""
	LDFLAGS+=" -lX11 -lXinerama -lXft -lfontconfig -lfreetype"
}

post_install() {
	vlicense LICENSE
}
