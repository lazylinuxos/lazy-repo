# Template file for 'doublecmd-qt6-bin'
pkgname=doublecmd-qt6-bin
version=1.2.11
revision=1
archs="x86_64"
hostmakedepends="tar xz"
depends="qt6pas desktop-file-utils hicolor-icon-theme shared-mime-info"
short_desc="Twin-panel (commander-style) file manager"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-2.0-or-later"
homepage="http://doublecmd.sourceforge.net/"
distfiles="https://github.com/doublecmd/doublecmd/releases/download/v${version}/doublecmd-${version}.qt6.x86_64.tar.xz"
checksum=5afa1a56ecaf3fb2443a4f60a6b6808ecc2a91d1401b9ef91d59f203d4c5052a
make_dirs="/usr/lib/doublecmd/settings 1777 root root"
nopie=yes
noshlibprovides=yes

do_install() {
	vmkdir usr/lib/doublecmd
	vcopy ${wrksrc}/* usr/lib/doublecmd

	vinstall ${wrksrc}/doublecmd.png 644 usr/share/pixmaps
	vinstall ${FILESDIR}/doublecmd.desktop 644 usr/share/applications

	vmkdir usr/bin/
	ln -s /usr/lib/doublecmd/doublecmd ${DESTDIR}/usr/bin/
}
