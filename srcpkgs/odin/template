# Template file for 'odin'
pkgname=odin
version=2026.10
revision=1
_tag="dev-${version//./-}"
build_style="gnu-makefile"
make_build_args="release"
hostmakedepends="clang llvm which"
makedepends="llvm21-devel"
checkdepends="python3"
depends="clang"
short_desc="Fast, concise, readable, pragmatic programming language"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="zlib"
homepage="https://odin-lang.org/"
distfiles="https://github.com/odin-lang/Odin/archive/refs/tags/${_tag}.tar.gz"
checksum=f72a045c956c6fe09937d8283b9a3a69ca11197993a6cee8bdaf1ed5205e9f13
skiprdeps="/usr/lib/odin/vendor/raylib/linux-arm64/libraylib.so.600"
nostrip=yes

pre_build() {
	export LLVM_CONFIG=llvm-config
	export CXX=clang++

	find vendor \
		\( \
			-name windows -o \
			-name macos -o \
			-name macos-arm64 -o \
			-name darwin -o \
			-name "*.lib" -o \
			-name "*.dll" -o \
			-name "*.a" -o \
			-name "*.dylib" -o \
			-name "*.so.*" -o \
			-name "*.so" \
		\) \
		-exec rm -rf {} +
}

post_build() {
	cd ${wrksrc}/vendor/miniaudio/src
	./build_miniaudio.sh
	cd ${wrksrc}/vendor/stb/src
	./build_stb.sh
	cd ${wrksrc}/vendor/cgltf/src
	./build_cgltf.sh
}

do_check() {
	./odin check examples/all -strict-style
	./odin test tests/benchmark -file -all-packages -define:ODIN_TEST_FANCY=false
	./odin test tests/core/normal.odin -file -all-packages -define:ODIN_TEST_FANCY=false
	./odin test tests/core/speed.odin -file -all-packages -o:speed -define:ODIN_TEST_FANCY=false
	./odin test tests/vendor -all-packages -define:ODIN_TEST_FANCY=false
}

do_install() {
	vmkdir usr/lib/odin
	vinstall odin 755 usr/lib/odin

	for d in base core shared vendor; do
		vcopy "$d" usr/lib/odin
	done

	vmkdir usr/bin
	ln -s /usr/lib/odin/odin ${DESTDIR}/usr/bin

	vdoc README.md
	vdoc PROPOSAL-PROCESS.md
	vlicense LICENSE
}
