# Template file for 'fluxcast'
pkgname=fluxcast
version=0.3.0
revision=1
depends="dnsmasq ffmpeg glib gstreamer1-pipewire gst-plugins-bad1 gst-plugins-base1
 gst-plugins-good1 gst-plugins-ugly1 gst1-python3 gstreamer1 iw libayatana-appindicator
 libnotify libpulseaudio NetworkManager python3-dbus-next python3-gobject python3-Pillow
 python3-pystray python3-tkinter tk wf-recorder wpa_supplicant xdg-desktop-portal xrandr"
short_desc="Stream your Linux desktop to a Smart TV via Miracast/WFD, DLNA, or Cast"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/IlyaP358/fluxcast"
distfiles="https://github.com/IlyaP358/fluxcast/archive/refs/tags/v${version}.tar.gz"
checksum=6097b4e0293904dc0af41d750a980df8405c8a3cf6df8eaef7b3e5ee623b2f5a

do_install() {
	FLUXCAST_VERSION="$version" \
		DESTDIR="$DESTDIR" ./meta/install.sh

	vdoc README.md
	vinstall documentation/DOCUMENTATION.md 644 usr/share/doc/fluxcast/documentation

	if [ -f "${DESTDIR}/opt/fluxcast/version.py" ]; then
		sed -i \
			"s|^__installed_version__ = \"dev\"|__installed_version__ = \"${version}\"|" \
			"${DESTDIR}/opt/fluxcast/version.py"
	fi
}
