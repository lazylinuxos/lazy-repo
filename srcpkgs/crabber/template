# Template file for 'crabber'
pkgname=crabber
version=0.9.3
revision=1
build_style=cargo
build_helper="rust"
hostmakedepends="clang pkgconf"
makedepends="Vulkan-Headers alsa-lib-devel dbus-devel fontconfig-devel
 freetype-devel libX11-devel libxcb-devel libxkbcommon-devel pipewire-devel
 vulkan-loader-devel wayland-devel sqlite-devel"
depends="noto-fonts-emoji"
short_desc="XMPP messenger built on GPUI"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="MIT"
homepage="https://github.com/auf-gg/crabber"
distfiles="https://github.com/auf-gg/crabber/archive/refs/tags/v${version}.tar.gz"
checksum=2b6c9c5fd5b5fb3006bde872aca1090115b6d61f4013beef6b37a3acd51e660e

do_install() {
 vbin target/${RUST_TARGET}/release/crabber

 vinstall icon.png 644 usr/share/icons/hicolor/1024x1024/apps crabber.png
 vinstall icon.svg 644 usr/share/icons/hicolor/scalable/apps crabber.svg

 vinstall ${FILESDIR}/crabber.desktop 644 usr/share/applications
}
