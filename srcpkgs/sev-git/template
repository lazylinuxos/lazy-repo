# Template file for 'sev-git'
pkgname=sev-git
version=r521.adbea50
revision=1
_gitrev="${version##*.}"
_pcre2_version=10.49
_tree_sitter_version=0.26.8
_tree_sitter_json_version=0.24.8
_tree_sitter_scheme_version=0.24.7-1
build_style=cmake
configure_args="-DUSE_VENDORED=OFF"
hostmakedepends="pkg-config"
makedepends="libglvnd-devel SDL3-devel SDL3_image-devel SDL3_ttf-devel chibi-scheme-devel" # tree-sitter-devel tree-sitter-scheme pcre2-devel
short_desc="Graphical Emacs-like text editor"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="MIT"
homepage="https://github.com/dylancobb/sev"
distfiles="https://github.com/dylancobb/sev/archive/${_gitrev}.tar.gz
 https://github.com/PCRE2Project/pcre2/archive/refs/tags/pcre2-${_pcre2_version}.tar.gz>pcre2.tar.gz
 https://github.com/tree-sitter/tree-sitter/archive/refs/tags/v${_tree_sitter_version}.tar.gz>tree-sitter.tar.gz
 https://github.com/tree-sitter/tree-sitter-json/archive/refs/tags/v${_tree_sitter_json_version}.tar.gz>tree-sitter-json.tar.gz
 https://github.com/6cdh/tree-sitter-scheme/archive/refs/tags/v${_tree_sitter_scheme_version}.tar.gz>tree-sitter-scheme.tar.gz"
checksum="b9672d91b3ed9c78206d5203517e623096a80c9b6dfb5169f33f3af70dc0aeec
 69d04dcddcf9e038aeae8f58b0c07ee5e08abb835ee8daa2bd6acee433dc112c
 e6826b7533ec3a885aba598377a6d20b5a6321ff3db76968e960c2352d3a5077
