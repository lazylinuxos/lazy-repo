# Template file for 'python3-proton-vpn-api-core'
pkgname=python3-proton-vpn-api-core
version=5.8.11
revision=1
_protun_tag=3.0.1
build_style=python3-pep517
hostmakedepends="python3-build python3-installer python3-setuptools
 python3-wheel python3-packaging-bootstrap cargo rust pkg-config"
makedepends="libmnl-devel libnftnl-devel"
depends="NetworkManager-openvpn libnm python3 python3-cryptography
 python3-distro python3-Jinja2 python3-dbus-fast python3-cairo
 python3-gobject python3-pynacl python3-packaging python3-sentry
 python3-fido2 python3-proton-core"
checkdepends="python3-pytest python3-pytest-cov python3-pytest-asyncio
 python3-proton-vpn-api-core"
short_desc="Facade API for Proton VPN services"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/ProtonVPN/python-proton-vpn-api-core"
distfiles="https://github.com/ProtonVPN/python-proton-vpn-api-core/archive/refs/tags/v${version}.tar.gz
 https://github.com/ProtonVPN/protun/archive/refs/tags/v${_protun_tag}.tar.gz>protun.tar.gz"
checksum="97352c2d8ca8d7450eeb209e9f83250ab411fc62525dde4549790c78fd3ac2bd
 6204027ab912c33aacc7ae9535d1f622154e9d85076785824f6e05baf9514d0a"
skip_extraction="protun.tar.gz"
provides="py3:proton-vpn-local-agent-${version}_${revision}"
replaces="python3-proton-vpn-local-agent>=0"

post_extract() {
	vsrcextract -C "${wrksrc}/dependencies/protun" "protun.tar.gz"
}

post_patch() {
	sed -i '/^SystemdService=/d' resources/nm-protun.name
}

pre_build() {
	CARGO_REGISTRIES_PROTON_INDEX="sparse+https://rust-registry.proton.me/index/" \
		cargo build --release --locked \
			--bin nm-protun-service \
			--bin proton-vpn-kill-switch-service \
			--lib \
			--features "protun,python,core,local_agent,kill_switch,telemetry"

	# The Python extension must be present before the PEP517 wheel is built.
	install -Dm755 target/release/libproton_vpn_platform.so	proton/vpn/platform.abi3.so
}

post_install() {
	vdoc ${FILESDIR}/README.voidlinux

	vinstall target/release/nm-protun-service 755 usr/lib
	vinstall target/release/proton-vpn-kill-switch-service 755 usr/lib

	vinstall resources/nm-protun-service.conf 644 usr/share/dbus-1/system.d
	vinstall resources/proton-vpn-kill-switch.conf 644 \
		usr/share/dbus-1/system.d me.proton.vpn.kill_switch.conf
	vinstall resources/proton-vpn-kill-switch.dbus-service 644 \
		usr/share/dbus-1/system-services me.proton.vpn.kill_switch.service

	vmkdir usr/lib/NetworkManager/VPN
	sed -e 's|program=.*|program=/usr/lib/nm-protun-service|' \
		-e 's|auth-dialog=.*|auth-dialog=/usr/lib/nm-protun-auth-dialog|' \
		resources/nm-protun.name \
		> "${DESTDIR}/usr/lib/NetworkManager/VPN/nm-protun.name"
}
