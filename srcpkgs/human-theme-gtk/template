do_install() {
    vinstall data/profile.sh 644 etc/profile.d human-theme-gtk.sh

    vmkdir usr/share/themes
    vcopy src/Human usr/share/themes
    vcopy src/Human-blue usr/share/themes
    vcopy src/Human-green usr/share/themes
    vcopy src/Human-orange usr/share/themes

    vdoc README.md
}
