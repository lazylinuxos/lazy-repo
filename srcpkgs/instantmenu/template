# Template file for 'instantmenu'
pkgname=instantmenu
version=5.2.4
revision=1
build_style=cargo
build_helper="rust"
make_build_args="--bin instantmenu --bin itest"
hostmakedepends="pkg-config"
makedepends="fontconfig-devel libxcb-devel libxkbcommon-devel"
depends="bash"
short_desc="A dynamic menu for X11 and Wayland"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="MIT"
homepage="https://github.com/instantOS/instantMENU"
distfiles="https://github.com/instantOS/instantMENU/archive/refs/tags/v${version}.tar.gz"
checksum=f4a92003aed7d724170c6bdb85a700b024e37edc056f9aa13dfd4b32b2061a0a

do_install() {
	vbin target/${RUST_TARGET}/release/instantmenu
	vbin target/${RUST_TARGET}/release/itest

	vbin instantmenu_path
	vbin instantmenu_run

	vman instantmenu.1
	vlicense LICENSE
	vdoc README.md
}
