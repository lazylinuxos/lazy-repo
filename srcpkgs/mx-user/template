# Template file for 'mx-user'
pkgname=mx-user
version=26.07.1
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release
 -DHELPER_INSTALL_DIR=/usr/lib/mx-user
 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
 -DENABLE_ZXCVBN=OFF
 -DBUILD_FOR_ARCH=ON
 -DPROJECT_VERSION_OVERRIDE=${version}"
hostmakedepends="qt6-tools"
makedepends="qt6-base-devel"
depends="polkit rsync shadow"
short_desc="Simple user configuration tool"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://github.com/MX-Linux/mx-user"
distfiles="https://github.com/MX-Linux/mx-user/archive/refs/tags/${version}.tar.gz"
checksum=c4911f98343e399378644f9ca8b4f20652698421206382b871d7a6fc0a6d1f7c

post_install() {
	for qm in build/*.qm; do
		[ -f "$qm" ] || continue
		vinstall "$qm" 644 usr/share/mx-user/locale
	done

	vinstall build/org.mxlinux.pkexec.mx-user-helper.policy 644 usr/share/polkit-1/actions
	vinstall mx-user.desktop 644 usr/share/applications
	vinstall icons/mx-user.png 644 usr/share/icons/hicolor/256x256/apps
	vinstall icons/mx-user.svg 644 usr/share/icons/hicolor/scalable/apps

	if [ -d help ]; then
		for file in help/*; do
			[ -f "$file" ] || continue
			vinstall "$file" 644 usr/share/doc/mx-user
		done
	fi
}
