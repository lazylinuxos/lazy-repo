makedepends="acl-devel cairo-devel libcurl-devel dconf-devel
 fontconfig-devel freetype-devel gdk-pixbuf-devel glib-devel
 harfbuzz-devel libarchive-devel libglvnd-devel libpng-devel
 librsvg-devel libxkbcommon-devel libxml2-devel pango-devel
 tomlplusplus-devel wayland-devel json-c++ stb"
depends="adwaita-icon-theme gsettings-desktop-schemas gvfs
 hicolor-icon-theme shared-mime-info"
