# Template file for 'skarwm'
pkgname=skarwm
version=${VERSION}
revision=1
build_style=gnu-makefile
make_install_args="PREFIX=/usr"
hostmakedepends="odin"
makedepends="libX11-devel libxcb-devel libXft-devel"
depends="st xsetroot"
short_desc="Tiling + scrollable x11 WM written in Odin"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/nerdyslacker/skarwm"
distfiles="https://github.com/nerdyslacker/skarwm/archive/refs/tags/v${version}.tar.gz"
checksum=${SHA256}

post_install() {
	for f in $(find docs -type f -name '*.md'); do vdoc "$f"; done
	vdoc README.md
	vlicense LICENSE
}
