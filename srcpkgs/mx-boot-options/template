# Template file for 'mx-boot-options'
pkgname=mx-boot-options
version=26.07.1
revision=1
build_style=cmake
configure_args="-DCMAKE_BUILD_TYPE=Release
 -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
 -DPROJECT_VERSION_OVERRIDE=${version}"
hostmakedepends="qt6-tools"
makedepends="qt6-base-devel"
depends="polkit"
short_desc="GUI for managing boot options and UEFI settings"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://mxlinux.org"
distfiles="https://github.com/MX-Linux/mx-boot-options/archive/refs/tags/${version}.tar.gz"
checksum=326e20f520f6f5276ca71f6d9e69c471dcd75eea9f5a11b0142efe2b11cebbe6

post_install() {
	for qm in build/*.qm; do
		[ -f "$qm" ] || continue
		vinstall "$qm" 644 usr/share/mx-boot-options/locale
	done

	vinstall scripts/org.mxlinux.pkexec.mxbo-helper.policy 644 usr/share/polkit-1/actions
	vinstall mx-boot-options.desktop 644 usr/share/applications
	vinstall images/mx-boot-options.png	644 usr/share/icons/hicolor/1024x1024/apps
	vinstall images/mx-boot-options.svg	644 usr/share/icons/hicolor/scalable/apps

	if [ -d help ]; then
		for file in help/*; do
			[ -f "$file" ] || continue
			vinstall "$file" 644 usr/share/doc/mx-boot-options
		done
	fi

	vdoc ${FILESDIR}/README.voidlinux
}
