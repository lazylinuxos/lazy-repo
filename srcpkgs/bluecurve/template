do_install() {
	# Install the files
	vmkdir /usr/share/themes
	vmkdir /usr/share/icons
	vmkdir /usr/share/fonts
	vcopy Bluecurve/themes/* /usr/share/themes
	vcopy Bluecurve/icons/* /usr/share/icons
	vcopy Bluecurve/fonts/*.ttf /usr/share/fonts
}
