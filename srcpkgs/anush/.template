# Template file for 'anush'
pkgname=anush
version=${VERSION}
revision=1
build_style=gnu-makefile
make_install_args="PREFIX=/usr"
hostmakedepends="odin"
depends="skarwm quickshell python3 python3-gobject picom dunst feh kitty
 clipmenu xdotool setxkbmap xkb-switch renCal NetworkManager bluez curl
 pavucontrol xset brightnessctl power-profiles-daemon xrandr redshift-gtk
 xclip xcolor xdg-utils xinput flameshot xinput libnotify ImageMagick
 lxqt-policykit xss-lock betterlockscreen udiskie elogind xterm iproute2
 iw dnsmasq hostapd create_ap papirus-icon-theme papirus-folders matugen
 adw-gtk3-theme nerd-font-jetbrainsmono"
short_desc="Full desktop configuration for skarwm"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/nerdyslacker/anush"
distfiles="https://github.com/nerdyslacker/anush/archive/refs/tags/v${version}.tar.gz"
checksum=${SHA256}

post_install() {
	for f in $(find docs -type f -name '*.md'); do vdoc "$f"; done
	vdoc README.md
	vlicense LICENSE
}
