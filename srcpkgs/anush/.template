# Template file for 'anush'
pkgname=anush
version=${VERSION}
revision=1
build_style=gnu-makefile
make_install_args="PREFIX=/usr"
hostmakedepends="odin"
depends="quickshell python3 python3-gobject picom dunst feh kitty
 minni xprop setxkbmap xkb-switch renCal NetworkManager bluez curl
 pavucontrol xset brightnessctl power-profiles-daemon xrandr redshift-gtk
 xclip xcolor xdg-utils xinput flameshot xmodmap libnotify ImageMagick
 polkit lxqt-policykit xss-lock betterlockscreen udiskie elogind xterm
 iproute2 iw dnsmasq hostapd create_ap plocate fd matugen adw-gtk3-theme
 papirus-icon-theme papirus-folders fontconfig nerd-font-jetbrainsmono"
short_desc="Desktop shell for X11 window managers"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="BSD-2-Clause"
homepage="https://github.com/nerdyslacker/anush"
distfiles="https://github.com/nerdyslacker/anush/archive/refs/tags/v${version}.tar.gz"
checksum=${SHA256}

post_install() {
	for f in $(find docs -type f -name '*.md'); do vdoc "$f"; done
	vdoc README.md
	vlicense LICENSE
}

anush-skarwm_package() {
	metapackage=yes
	depends="${sourcepkg}>=${version}_${revision} skarwm"
	short_desc="${sourcepkg} desktop shell - skarwm integration"
	license="Public Domain"
}

