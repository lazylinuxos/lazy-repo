depends="python3-jaraco.text python3-inflect python3-pydantic python3-typing_extensions
 python3-pyqt6-gui python3-pyqt6-network python3-pyqt6-widgets python3-pyqt6-dbus
 python3-pyqt6-webchannel python3-pyqt6-printsupport"
short_desc="WhatsApp desktop application written in PyQt6 + PyQt6-WebEngine"
maintainer="nerdyslacker <karyan40024@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://rtosta.com/zapzap"
distfiles="https://github.com/rafatosta/zapzap/archive/refs/tags/${version}.tar.gz"
checksum=${SHA256}

post_install() {
    vinstall share/icons/com.rtosta.zapzap.svg 644 usr/share/icons/hicolor/scalable/apps/
